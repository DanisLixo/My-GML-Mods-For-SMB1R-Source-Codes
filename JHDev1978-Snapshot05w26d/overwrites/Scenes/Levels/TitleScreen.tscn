[sub_resource type="GDScript" id="GDScript_8peil"]
script/source = "extends Label

func _ready() -> void:
	Global.is_snapshot = true
	
	Global.version_number = \"0.9.2\"
	Global.current_snapshot = \"05w26d\"
	
	text = \"V\" + Global.version_number
	if Global.is_snapshot:
		text += \"\\n\" + Global.current_snapshot
"

