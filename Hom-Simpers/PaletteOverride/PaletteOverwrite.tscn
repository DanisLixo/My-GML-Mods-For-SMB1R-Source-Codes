shader = SubResource("Shader_lb6ks")
shader_parameter/enabled = true
shader_parameter/palette_size = 64.0
shader_parameter/override_palette_size = 64.0
shader_parameter/closest = 0.5
shader_parameter/game_palette = ExtResource("1_bcfub")
shader_parameter/override_palette = ExtResource("4_nf7bg")

