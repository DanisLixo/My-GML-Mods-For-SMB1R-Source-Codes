[sub_resource type="Shader" id="Shader_lb6ks"]
resource_local_to_scene = true
code = "shader_type canvas_item;
render_mode blend_mix;

uniform bool enabled = false;
uniform float palette_size = 64.0;
uniform float override_palette_size = 64.0;
uniform float closest = 0.50;

uniform sampler2D screen_texture : hint_screen_texture, repeat_disable, filter_nearest;
uniform sampler2D game_palette: filter_nearest;
uniform sampler2D override_palette: filter_nearest;

void fragment() {
	if (enabled)
	{
		vec3 source_col = texture(screen_texture, SCREEN_UV).rgb;
	    float closest_distance = closest;

	    for (int i = 0; i < int(palette_size); i++)
		{
		    float x_coord = (float(i) + 0.5) / palette_size;

		    vec3 sampled = texture(game_palette, vec2(x_coord, 0.0)).rgb;

		    float d = distance(sampled, source_col);
		    if (d < closest_distance)
		    {
		        float inv_x_coord = (float(i) + 0.5) / palette_size;

		        source_col = texture(override_palette, vec2(inv_x_coord, 0)).rgb;
		        closest_distance = d;
		    }
		}
		COLOR.rgb = source_col;
	}
}
"

