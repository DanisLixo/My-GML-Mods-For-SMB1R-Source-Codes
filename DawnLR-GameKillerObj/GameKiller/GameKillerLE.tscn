[sub_resource type="GDScript" id="GDScript_esc8w"]
script/source = "extends EditorTileSelector

func _ready() -> void:
	set_icon_texture()
	set_second_icon_texture()
	update_visuals()
	set_process(false)
	if tile_selected.is_connected(get_tree().current_scene.on_tile_selected) == false:
		tile_selected.connect(get_tree().current_scene.on_tile_selected)
	%NameLabel.text = tile_name
"

