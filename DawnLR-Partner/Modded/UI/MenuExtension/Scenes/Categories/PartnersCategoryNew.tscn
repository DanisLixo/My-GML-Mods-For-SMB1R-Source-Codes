[sub_resource type="GDScript" id="GDScript_34jd6"]
script/source = "extends Node

@export var warning_label: Label

var text := \"OOPS! SEEMS LIKE IT's STILL IN DEVELOPMENT!\"

func on_value_changed(_new_value: Variant) -> void:
	if (get_parent().selected_index == 1):
		AudioManager.play_global_sfx(\"bump\")
		
		get_parent().selected_index = 0
		get_parent().value_changed.emit(0)
		
		show_label()

func show_label() -> void:
	if warning_label != null:
		warning_label.self_modulate = Color.RED
		
		var before = get_parent().value_descs[0]
		
		get_parent().value_descs[0] = text
		await get_tree().create_timer(2.0, true).timeout
		get_parent().value_descs[0] = before
		warning_label.self_modulate = Color.WHITE
"

