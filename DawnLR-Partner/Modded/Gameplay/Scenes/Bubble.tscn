[sub_resource type="GDScript" id="GDScript_5fnvr"]
script/source = "extends Node

@export var length := 80

var currentRotation := 0.0

func _physics_process(delta: float) -> void:
	# I grabbed this from the BooBuddies script but I made some adjustments
	var amount = owner.icons.size()
	var spread = (360 / amount)
	
	currentRotation = wrap(currentRotation + (45 * [1, -1][1]) * delta, 0, 360)
	
	var idx := 0
	for i in owner.icons:
		if is_instance_valid(i) == false:
			idx += 1
			continue
		i.show()
		# Position if there's only one
		if (amount == 1):
			owner.scaleMultiplier = Vector2(0.5, 0.5)
			i.global_position = $\"../Icons\".global_position
			continue
		# Position for the first four
		if (idx < 4):
			owner.scaleMultiplier = Vector2(0.75, 0.75)
			var real_amount = clampi(amount, 2, 4)
			spread = (360 / real_amount)
			if idx < amount:
				i.global_position = $\"../Icons\".global_position + Vector2.from_angle(deg_to_rad(currentRotation + (spread * idx))).normalized() * (length - 10)
			else:
				i.global_position = Vector2(-999, 999)
		# Yeah
		else:
			spread = (360 / (amount - 4))
			if idx < amount:
				i.global_position = $\"../Icons\".global_position + Vector2.from_angle(deg_to_rad(currentRotation + (spread * (idx - 3)))).normalized() * length
			else:
				i.global_position = Vector2(-999, 999)
		idx += 1
"

