[sub_resource type="GDScript" id="GDScript_n081i"]
script/source = "extends TimerSprite

@export var node: Node2D

func _process(_delta: float) -> void:
	if (node == null):
		return
	var value = node.get(value_name)
	var percent = inverse_lerp(max_value, 0, value)
	percent = clamp(percent, 0, 1)
	frame = lerp(0, 6, percent)
	if (threshold_type == 0 and percent >= warn_threshold) or (threshold_type == 1 and value <= warn_threshold) and Settings.file.audio.extra_sfx == 1:
		if can_warn and percent > 0 and percent < 1:
			can_warn = false
			AudioManager.play_global_sfx(\"timer_warning\")
	else:
		can_warn = true
"

[sub_resource type="GDScript" id="GDScript_rxwtu"]
script/source = "extends Label

@export var parent: Control
@export var timer: Node
@export var valueName := \"\"

func _process(delta: float) -> void:
	if (timer == null): return
	var value = timer.get(valueName)
	
	text = str(snappedf(value, 0.1))
"

