[sub_resource type="GDScript" id="GDScript_r4e75"]
script/source = "extends VBoxContainer

@export var settings_category := \"video\"
@export var options: Array[Control] = []

var selected_index = -1
@export var minimum_idx := -1

@export var selected := false

var can_input = true

@onready var PartnerSettings = get_node(\"/root/ModLoader/DawnLR-Partner/PartnerSettingsManager\")
func _ready() -> void:
	update_partner_options(PartnerSettings.file.selector.partners_amount, true)

func _process(_delta: float) -> void:
	if (%Selector.active):
		if (%Selector.selected_index == %Selector.options.size() - 1):
			%Selector.can_input = false
			
			selected = true
			if (can_input):
				handle_input()
		if (selected_index == -1):
			if (!%Selector.can_input):
				selected = false
				%Selector.can_input = true
				%Selector.selected_index = %Selector.options.size() - 2
	var idx := 0
	for i in options:
		if i != null:
			i.selected = selected_index == idx and selected and can_input
			idx += 1

func handle_input() -> void:
	if Input.is_action_just_pressed(\"ui_down\"):
		selected_index += 1
		if Settings.file.audio.extra_sfx == 1:
			AudioManager.play_global_sfx(\"menu_move\")
	if Input.is_action_just_pressed(\"ui_up\"):
		selected_index -= 1
		if Settings.file.audio.extra_sfx == 1:
			AudioManager.play_global_sfx(\"menu_move\")
	if Input.is_action_just_pressed(\"ui_back\") && selected && can_input:
		selected_index = -1
	selected_index = clamp(selected_index, minimum_idx, options.size() - 1)
	if (get_children().size() != 0):
		get_child(selected_index).grab_focus()

func auto_get_options() -> void:
	options.clear()
	for i in get_children():
		if i is HBoxContainer || i is VBoxContainer:
			options.append(i)

var partnerOptionScene: PackedScene = preload(\"res://mods-unpacked/DawnLR-Partner/Scenes/UI/SettingsStuff/Selectables/SelectablePartnerOption.tscn\")
func update_partner_options(new_value: int, menuOnly: bool = false) -> void:
	var old_size = options.size() 
	
	if (old_size == new_value): 
		return
	elif (new_value > old_size):
		while options.size() < new_value:
			add_partner_option((new_value >= 4 && !menuOnly), !menuOnly)
	else:
		while options.size() > new_value:
			remove_partner_option((new_value >= 3 && !menuOnly))
	
	await get_tree().physics_frame
	auto_get_options()
	if (!menuOnly):
		PartnerSettings.file.selector.characters = Global.player_characters
		PartnerSettings.save_settings()

func add_partner_option(add_to_global: bool = false, override_global_value: bool = true) -> void:
	var new_value = options.size() + 1
	if (add_to_global):
		Global.player_characters.push_back(0)
	elif (override_global_value):
		Global.player_characters[new_value] = 0
	
	var newOpt = partnerOptionScene.instantiate()
	newOpt.option_key = \"characters\"
	newOpt.title = \"PARTNER player_id\"
	newOpt.settings_category = \"selector\"
	newOpt.value_changed.connect(%PartnerSelector.a_partner_id_changed)
	newOpt.player_id = new_value
	
	add_child(newOpt)
	options.push_back(newOpt)

func remove_partner_option(remove_from_global: bool = false) -> void:
	var new_value = options.size() - 1
	if (options[new_value] != null):
		options[new_value].queue_free()
	options.resize(new_value)
	if (remove_from_global):
		Global.player_characters.resize(new_value + 1)
	else:
		Global.player_characters[new_value + 1] = -1
"

[sub_resource type="GDScript" id="GDScript_w85xu"]
script/source = "extends Node

@onready var PartnerSettings = get_node(\"/root/ModLoader/DawnLR-Partner/PartnerSettingsManager\")

func set_value(value_name := \"\", value = null) -> void:
	{
		\"partner_follow_mode\": null,
		\"partners_amount\": null
	}[value_name].call(value)
"

