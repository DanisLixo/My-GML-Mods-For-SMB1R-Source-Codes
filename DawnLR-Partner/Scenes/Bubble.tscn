[sub_resource type="GDScript" id="GDScript_khxa3"]
script/source = "extends PackSprite

const burstScene := preload(\"res://mods-unpacked/DawnLR-Partner/Scenes/BubbleBurst.tscn\")
var thingie: PartnerThingie

func _process(delta: float) -> void:
	var floated := snappedf(thingie.spawnTime, 0.1)
	$Label.text = str(floated)

func _exit_tree() -> void:
	var burst := burstScene.instantiate()
	get_tree().current_scene.add_child(burst)
	burst.global_position = global_position
"

