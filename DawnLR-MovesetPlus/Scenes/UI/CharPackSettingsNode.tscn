[sub_resource type="GDScript" id="GDScript_apagd"]
script/source = "extends \"res://Scripts/UI/ResourcePackConfigMenu.gd\"

signal opened

func open():
	super()
	opened.emit()

func close() -> void:
	var oldID = Global.player_characters[0]
	Global.player_characters[0] = selected_index
	
	super()
	
	await get_tree().process_frame
	Global.player_characters[0] = oldID
"

