[sub_resource type="GDScript" id="GDScript_3owq6"]
script/source = "extends Label


# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	var characterRandomizer = get_node(\"/root/ModLoader/DawnLR-CharacterRandomizer/CharacterRandomizer\")
	if (characterRandomizer.file.options.alwaysShowInitialWarning == 1):
		text = \"Hi Again! You're seeing this message because you set for it to always appear. Configurations can be found in the 'randomizer.cfg' file in the save folder.\"
"

