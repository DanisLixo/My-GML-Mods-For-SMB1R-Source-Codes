[sub_resource type="GDScript" id="GDScript_jngjr"]
script/source = "extends Node2D

var original_scene := \"\"
@export var original_id := \"\"
@export var original_info := \"\"

var backup := [original_scene, original_id, original_info]

func _enter_tree() -> void:
	var c_list = NewLevelBuilder.get_meta(\"custom_list\", {})
	
	if (!c_list.is_empty()):
		original_scene = c_list[original_id][0]
	backup = [original_scene, original_id, original_info]

func _process(_delta: float) -> void:
	if (Global.level_editor == null):
		free()
		return 
	if (Global.level_editor.playing_level): return
	
	if (original_scene != backup[0]):
		original_scene = backup[0]
	if (original_id != backup[1]):
		original_id = backup[1]
	if (original_info != backup[2]):
		original_info = backup[2]
"

